# Your main site address (no trailing slash). jerttech.app redirects here.
# On your computer, use http://localhost:3000 instead.
NEXT_PUBLIC_SITE_URL=https://jerttech.com

# Firebase (project "Aura", aura-55447). Firebase console > Project settings > General > Your apps > JertTech (web app).
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aura-55447.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aura-55447
NEXT_PUBLIC_FIREBASE_APP_ID=1:723937303605:web:your-app-id

# The JertTech Firestore database inside the Aura project.
FIRESTORE_DATABASE_ID=ai-studio-628693c8-0773-4dc5-bbcc-e8b408cb96e0

# Server key: the service account's JSON key file, base64-encoded on one line.
# Make it with:  base64 -i jerttech-web-key.json | tr -d '\n'
# Keep it secret. Never commit it.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Stripe: Developers > API keys, and Developers > Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
